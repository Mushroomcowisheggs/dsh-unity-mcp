{
  "name": "dsh-unity-mcp",
  "version": "1.0.0",
  "description": "DeepSeek Harness 插件：一键接入 mcp-unity，让 Agent 直接操控 Unity 编辑器进行游戏开发（场景/物体/材质/测试等 30+ 工具）",
  "main": "lib/index.js",
  "type": "module",
  "license": "MIT",
  "author": "dsh-unity-mcp contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/thyeff/dsh-unity-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs vendor",
    "smoke:install": "node scripts/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.1.1-rc.2",
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "uuid": "^11.1.0",
    "winreg": "^1.2.5",
    "ws": "^8.18.1",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.24.3"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "unity",
    "mcp",
    "mcp-unity",
    "game-development",
    "游戏开发"
  ],
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
